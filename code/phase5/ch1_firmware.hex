// ch1_firmware.hex — 教学型 RV32I 固件（手工汇编，32-bit 字，$readmemh 加载）
// 功能：x5 循环求和 1..10 -> 应得 55(0x37)；把结果存到 RAM[0]；
//       再通过内存映射 UART(0x10000000) 连续打印两个字符 '5'(0x35)。
//
//  字节地址  机器码       汇编
//  0x000     0x00000293  addi  x5, x0, 0      ; sum = 0
//  0x004     0x00000313  addi  x6, x0, 1      ; i = 1
//  0x008     0x00B00E13  addi  x28, x0, 11    ; bound = 11
//  0x00C     0x006282B3  add   x5, x5, x6     ; loop: sum += i
//  0x010     0x00130313  addi  x6, x6, 1      ; i++
//  0x014     0x01C32433  slt   x8, x6, x28    ; x8 = (i < 11)
//  0x018     0xFE0412E3  bne   x8, x0, -12    ; if (i<11) goto loop
//  0x01C     0x00502023  sw    x5, 0(x0)      ; RAM[0] = sum = 0x37
//  0x020     0x100004B7  lui   x9, 0x10000    ; x9 = 0x1000_0000 (UART base)
//  0x024     0x03500513  addi  x10, x0, 0x35  ; '5'
//  0x028     0x00A4A023  sw    x10, 0(x9)    ; print '5'
//  0x02C     0x00A4A023  sw    x10, 0(x9)    ; print '5'
//  0x030     0x00000063  beq   x0, x0, 0      ; halt(原地跳转)
0x00000293
0x00000313
0x00B00E13
0x006282B3
0x00130313
0x01C32433
0xFE0412E3
0x00502023
0x100004B7
0x03500513
0x00A4A023
0x00A4A023
0x00000063
