  "cards": [
    {
      "id": "dig-c001",
      "sub": "shuzhi",
      "title": "二/八/十/十六进制互转",
      "body": "① 每4位二进制=1位十六进制；每3位=1位八进制。\n② 十进制转二/八/十六用'除基取余'。\n③ FPGA内部只有二进制。",
      "src": ""
    },
    {
      "id": "dig-c002",
      "sub": "shuzhi",
      "title": "位宽范围",
      "body": "① n位无符号 0~2^n-1；n位补码 -2^(n-1)~2^(n-1)-1。\n② 8位无符号0~255；8位补码-128~127。",
      "src": ""
    },
    {
      "id": "dig-c003",
      "sub": "shuzhi",
      "title": "BCD码",
      "body": "① 4位二进制表1位十进制(0000~1001)。\n② 12 的 BCD=0001 0010。用于数码管。",
      "src": ""
    },
    {
      "id": "dig-c004",
      "sub": "shuzhi",
      "title": "格雷码",
      "body": "① 相邻码只差1位，消除翻码冒险。\n② 用于跨时钟指针、旋转编码器。\n③ g=b xor (b>>1)。",
      "src": ""
    },
    {
      "id": "dig-c005",
      "sub": "shuzhi",
      "title": "原反补码",
      "body": "① 正数三码相同。\n② 负数反码=取反，补码=反码+1。\n③ FPGA有符号运算用补码，减法变加法。",
      "src": ""
    },
    {
      "id": "dig-c006",
      "sub": "shuzhi",
      "title": "符号拓展",
      "body": "① 有符号数拓展=符号位向左复制。\n② 无符号数拓展=左边补0。\n③ 4位-1(1111)扩到8位=11111111。",
      "src": ""
    },
    {
      "id": "dig-c007",
      "sub": "shuzhi",
      "title": "常见幂次",
      "body": "① 2^10=1024，2^20=1,048,576。\n② 50MHz→1Hz半周期=25,000,000。",
      "src": ""
    },
    {
      "id": "dig-c008",
      "sub": "shuzhi",
      "title": "ASCII",
      "body": "① '0'=0x30，'A'=0x41，'a'=0x61。\n② 串口按字节传ASCII。",
      "src": ""
    },
    {
      "id": "dig-c009",
      "sub": "men",
      "title": "基本逻辑门",
      "body": "① AND全1出1；OR有1出1。\n② NOT取反；NAND/NOR。\n③ XOR不同出1，XNOR相反。",
      "src": ""
    },
    {
      "id": "dig-c010",
      "sub": "men",
      "title": "布尔定律",
      "body": "① A+0=A,A+1=1,A·0=0,A·1=A。\n② A+A=A,A·A=A,A+A'=1,A·A'=0。",
      "src": ""
    },
    {
      "id": "dig-c011",
      "sub": "men",
      "title": "德摩根",
      "body": "① (A·B)'=A'+B'；(A+B)'=A'·B'。\n② 与非门可凑出任意门。",
      "src": ""
    },
    {
      "id": "dig-c012",
      "sub": "men",
      "title": "XOR用途",
      "body": "① A^B=0表示相等。\n② 可控反相器：B=1则~A。\n③ 奇偶校验。",
      "src": ""
    },
