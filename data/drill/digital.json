{
  "cat": "digital",
  "catName": "数字电路与电平标准",
  "cards": [
    {
      "id": "dig-c001",
      "sub": "shuzhi",
      "title": "二进制与十六进制",
      "body": "① 每4位二进制对应1位十六进制（0000~1111 = 0~F）。\n② 八进制每3位一组；十进制逢10进1。\n③ FPGA内部只用高低电平，天然是二进制世界。",
      "src": "AMD UG199"
    },
    {
      "id": "dig-c002",
      "sub": "shuzhi",
      "title": "位宽与能表示的数值",
      "body": "① n位无符号范围 0 ~ 2^n-1。\n② n位有符号(补码)范围 -2^(n-1) ~ 2^(n-1)-1。\n③ 例：8位无符号 0~255；8位有符号 -128~127。",
      "src": ""
    },
    {
      "id": "dig-c003",
      "sub": "shuzhi",
      "title": "BCD码",
      "body": "① BCD用4位二进制表示1位十进制(0000~1001)。\n② 12 的 BCD = 0001 0010。\n③ 常用于数码管/时钟显示，不是纯二进制。",
      "src": ""
    },
    {
      "id": "dig-c004",
      "sub": "shuzhi",
      "title": "格雷码(Gray)",
      "body": "① 相邻两个码只差1位，消除翻码冒险。\n② 常用于同步 FIFO 跨时钟域指针、旋转编码器。\n③ 二进制转格雷：g=b xor (b>>1)。",
      "src": ""
    },
    {
      "id": "dig-c005",
      "sub": "shuzhi",
      "title": "原码/反码/补码",
      "body": "① 正数三者相同。\n② 负数反码=按位取反；补码=反码+1。\n③ FPGA有符号运算一律用补码，减法变加法。",
      "src": ""
    },
    {
      "id": "dig-c006",
      "sub": "shuzhi",
      "title": "有符号数拓展",
      "body": "① 符号拓展：把最高位(符号位)向左复制。\n② 4位 -1(1111) 拓展到8位 = 11111111。\n③ 零拓展用于无符号数左边补0。",
      "src": ""
    },
    {
      "id": "dig-c007",
      "sub": "shuzhi",
      "title": "常见幂次",
      "body": "① 2^10=1,024(K)；2^20=1,048,576(M)；2^30=1,073,741,824(G)。\n② 50MHz 半周期到1Hz = 25,000,000。",
      "src": ""
    },
    {
      "id": "dig-c008",
      "sub": "shuzhi",
      "title": "ASCII/编码",
      "body": "① 数字'0'=0x30，'A'=0x41，'a'=0x61。\n② UART/串口按字节(8bit)传ASCII。",
      "src": ""
    },
    {
      "id": "dig-c009",
      "sub": "men",
      "title": "基本逻辑门",
      "body": "① AND与：全1出1；OR或：有1出1。\n② NOT非：取反；NAND与非、NOR或非。\n③ XOR异或：相同出0、不同出1；XNOR同或相反。",
      "src": ""
    },
    {
      "id": "dig-c010",
      "sub": "men",
      "title": "布尔代数定律",
      "body": "① 交换律/结合律/分配律同普通代数。\n② A+0=A, A+1=1, A·0=0, A·1=A。\n③ A+A=A, A·A=A, A+A'=1, A·A'=0。",
      "src": ""
    },
    {
      "id": "dig-c011",
      "sub": "men",
      "title": "德摩根定律",
      "body": "① (A·B)' = A' + B'；(A+B)' = A'·B'。\n② 与非可凑出任意门；FPGA LUT基于此实现。",
      "src": ""
    },
    {
      "id": "dig-c012",
      "sub": "men",
      "title": "XOR的用途",
      "body": "① 异或可做比较器：A^B=0 表示相等。\n② 可做可控反相器：B=1则输出~A，B=0则A。\n③ 奇偶校验。",
      "src": ""
    },
    {
      "id": "dig-c013",
      "sub": "men",
      "title": "最小项/最大项",
      "body": "① 最小项m：所有变量以原/反码出现且 AND。\n② 最大项M：所有变量 OR。\n③ 真值表→最小项之和(SOP)。",
      "src": ""
    },
    {
      "id": "dig-c014",
      "sub": "men",
      "title": "LUT如何实现函数",
      "body": "① 一个n输入LUT是2^n深的小RAM。\n② 把真值表写进去，输入即地址。\n③ Artix-7基本是6输入LUT。",
      "src": "AMD UG474"
    },
    {
      "id": "dig-c015",
      "sub": "zuhe",
      "title": "组合逻辑定义",
      "body": "① 输出只由当前输入决定，无记忆、无时钟。\n② 表达式里用 assign 或 always @(*)。\n③ 不写 always 时钟沿。",
      "src": ""
    },
    {
      "id": "dig-c016",
      "sub": "zuhe",
      "title": "真值表到电路",
      "body": "① 列出输入所有组合与输出。\n② 把输出为1的最小项写成SOP。\n③ 或化简后映射到LUT。",
      "src": ""
    },
    {
      "id": "dig-c017",
      "sub": "zuhe",
      "title": "卡诺图",
      "body": "① 方格相邻只差1位(格雷序)。\n② 圈1得SOP、圈0得POS。\n③ 圈越大项越少，速度越快。",
      "src": ""
    },
    {
      "id": "dig-c018",
      "sub": "zuhe",
      "title": "竞争与冒险",
      "body": "① 同一信号经不同路径延迟不同到达。\n② 输出出现毛刺(glitch)。\n③ 同步采样/加同步器/卡诺消项可消除。",
      "src": ""
    },
    {
      "id": "dig-c019",
      "sub": "zuhe",
      "title": "组合逻辑必须完整赋值",
      "body": "① always @(*) 里 if/else 要覆盖全情况。\n② 否则综合出 latch(锁存器)，不希望。\n③ 用 default 或先给默认值。",
      "src": "AMD UG901"
    },
    {
      "id": "dig-c020",
      "sub": "zhongzu",
      "title": "译码器",
      "body": "① n输入→2^n输出，每次仅1路有效(one-hot)。\n② 3-8译码器常用于地址译码。",
      "src": ""
    },
    {
      "id": "dig-c021",
      "sub": "zhongzu",
      "title": "编码器",
      "body": "① 与译码相反：多输入→二进制编号。\n② 优先编码器(优先编码器)常用。",
      "src": ""
    },
    {
      "id": "dig-c022",
      "sub": "zhongzu",
      "title": "多路选择器MUX",
      "body": "① sel选一路输入送到输出。\n② 可用assign case或三元嵌套。\n③ 数据通路核心。",
      "src": ""
    },
    {
      "id": "dig-c023",
      "sub": "zhongzu",
      "title": "加法器",
      "body": "① 半加器：sum=a^b, cout=a&b。\n② 全加器再加进位cin。\n③ 多级级联成RCA，更快用CLA。",
      "src": ""
    },
    {
      "id": "dig-c024",
      "sub": "zhongzu",
      "title": "比较器",
      "body": "① 比较两个数大小，输出 gt/eq/lt。\n② LUT 直接实现。",
      "src": ""
    },
    {
      "id": "dig-c025",
      "sub": "zhongzu",
      "title": "三态缓冲/使能",
      "body": "① 输出由 en 控制：en=0 时高阻 Z。\n② 现代FPGA少用片内三态，多用MUX。",
      "src": ""
    },
    {
      "id": "dig-c026",
      "sub": "shixu",
      "title": "时序逻辑本质",
      "body": "① 输出=当前输入+历史状态。\n② 由时钟沿驱动，触发器保存状态。\n③ always @(posedge clk ...)。",
      "src": ""
    },
    {
      "id": "dig-c027",
      "sub": "shixu",
      "title": "锁存器 vs 触发器",
      "body": "① 锁存器电平敏感(透明)。\n② 触发器边沿敏感(采样)。\n③ FPGA推荐用触发器，避免意外锁存器。",
      "src": ""
    },
    {
      "id": "dig-c028",
      "sub": "shixu",
      "title": "寄存器/流水线",
      "body": "① 触发器打一拍=寄存。\n② 流水线拆分长路径提频率。\n③ 每打一拍多1拍延迟。",
      "src": ""
    },
    {
      "id": "dig-c029",
      "sub": "shixu",
      "title": "建立时间/保持时间",
      "body": "① 建立tSU：数据须在时钟沿前稳定。\n② 保持tH：时钟沿后须再稳定一段时间。\n③ 不满足→亚稳态/采样错。",
      "src": "AMD UG474"
    },
    {
      "id": "dig-c030",
      "sub": "shixu",
      "title": "计数器",
      "body": "① 时序状态机：在时钟沿更新计数值。\n② 位宽由最大值决定：2^N>最大值。",
      "src": ""
    },
    {
      "id": "dig-c031",
      "sub": "shixu",
      "title": "亚稳态与同步",
      "body": "① 异步信号直接采可能亚稳。\n② 用两级触发器同步器打两拍。\n③ 跨时钟域必做同步。",
      "src": ""
    },
    {
      "id": "dig-c032",
      "sub": "dianping",
      "title": "LVCMOS电平",
      "body": "① LVCMOS3.3：高≈3.3V，低≈0V。\n② LVCMOS1.8：高≈1.8V。\n③ XDC里 IOSTANDARD=LVCMOS33。",
      "src": ""
    },
    {
      "id": "dig-c033",
      "sub": "dianping",
      "title": "TTL电平",
      "body": "① TTL高≈2.0~5V，低≤0.8V。\n② 3.3V LVCMOS 与5V TTL常可互通(注意耐压)。",
      "src": ""
    },
    {
      "id": "dig-c034",
      "sub": "dianping",
      "title": "LVDS",
      "body": "① 低压差分信号，两线互补。\n② 抗干扰强、速率高，用于高速传输/显示。\n③ 摆幅约±350mV。",
      "src": ""
    },
    {
      "id": "dig-c035",
      "sub": "dianping",
      "title": "推挽 vs 开漏",
      "body": "① 推挽：上下管主动驱动，可输出高低。\n② 开漏：只能拉低，需外部上拉电阻。\n③ I2C用开漏+上拉实现线与。",
      "src": ""
    },
    {
      "id": "dig-c036",
      "sub": "dianping",
      "title": "上拉/下拉电阻",
      "body": "① 上拉：默认高电平。\n② 下拉：默认低电平。\n③ 按键输入常用上拉，按下接地为低。",
      "src": ""
    },
    {
      "id": "dig-c037",
      "sub": "dianping",
      "title": "扇出/灌拉电流",
      "body": "① 一个输出能驱动的输入个数叫扇出。\n② 灌电流<拉电流(看器件)。\n③ 大电流需缓冲/电平转换芯片。",
      "src": ""
    },
    {
      "id": "dig-c038",
      "sub": "dianping",
      "title": "XDC电平声明",
      "body": "① set_property PACKAGE_PIN F16 [get_ports clk]。\n② set_property IOSTANDARD LVCMOS33 [get_ports {*}]。",
      "src": ""
    },
    {
      "id": "dig-c039",
      "sub": "shixu",
      "title": "状态机FSM",
      "body": "① 时序设计常用FSM：现态+输入→次态。\n② 一段式/两段式/三段式写法。\n③ FPGA里FSM用触发器寄存状态。",
      "src": ""
    },
    {
      "id": "dig-c040",
      "sub": "shixu",
      "title": "异步复位同步释放",
      "body": "① 复位异步生效(快)。\n② 释放时与时钟同步(避免亚稳)。\n③ 工业标准做法。",
      "src": ""
    },
    {
      "id": "dig-c041",
      "sub": "zuhe",
      "title": "case与if-else",
      "body": "① case是并行MUX，无优先级。\n② if-else有优先级(priority encoder)。\n③ 时序要求选合适写法。",
      "src": ""
    },
    {
      "id": "dig-c042",
      "sub": "zhongzu",
      "title": "计数器使能/加载",
      "body": "① 带en才计数；带load可预置初值。\n② 可做分频/脉冲生成。",
      "src": ""
    },
    {
      "id": "dig-c043",
      "sub": "dianping",
      "title": "电平转换",
      "body": "① 不同电压域之间需电平转换芯片。\n② 直接相连可能损坏IO或读错。",
      "src": ""
    },
    {
      "id": "dig-c044",
      "sub": "shuzhi",
      "title": "位拼接与选择",
      "body": "① {a,b}拼接；a[i:j]选位。\n② Verilog里最常用的位操作。",
      "src": ""
    },
    {
      "id": "dig-c045",
      "sub": "men",
      "title": "缓冲/延迟链",
      "body": "① 反相器链可做粗略延迟。\n② 关键路径延迟由布线+LUT决定。",
      "src": ""
    },
    {
      "id": "dig-c046",
      "sub": "zuhe",
      "title": "时序违例",
      "body": "① 建立时间不够→跑不上目标频率。\n② 改约束/加寄存器/缩短路径。",
      "src": ""
    }
