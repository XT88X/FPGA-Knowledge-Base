{
  "cat": "hardware",
  "catName": "FPGA 器件结构、选型与开发板硬件",
  "cards": [
    {
      "id": "hw-c001",
      "sub": "arch",
      "title": "LUT 的本质是小 RAM",
      "body": "① 一个 n 输入 LUT = 2^n 深、1 位宽的小 SRAM。\n② 真值表预先写进 SRAM，输入线即地址线。\n③ 输入组合选中对应位输出，因此任意组合逻辑都能用 LUT 实现。",
      "src": "AMD UG474"
    },
    {
      "id": "hw-c002",
      "sub": "arch",
      "title": "6 输入 LUT（LUT6）",
      "body": "① Artix-7 基本单元是 6 输入 LUT，深度 2^6=64 位。\n② 一个 LUT6 可拆成两个共享输入的 5 输入 LUT5。\n③ 6 输入是容量与灵活性的工程折中。",
      "src": "AMD UG474"
    },
    {
      "id": "hw-c003",
      "sub": "arch",
      "title": "Slice 的构成",
      "body": "① 7 系列一个 Slice = 4 个 6 输入 LUT + 8 个触发器。\n② 分 SLICEL（普通逻辑）与 SLICEM（可做分布式 RAM/移位寄存器）。\n③ 时序逻辑 = LUT 出组合 + FF 寄存。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c004",
      "sub": "arch",
      "title": "CLB 与 Slice 关系",
      "body": "① CLB（可配置逻辑块）由若干 Slice 组成。\n② 设计中的 LUT/FF 最终都映射进 Slice。\n③ 资源报告按 Slice/LUT/FF 计数。",
      "src": "AMD UG474"
    },
    {
      "id": "hw-c005",
      "sub": "arch",
      "title": "触发器 FF",
      "body": "① 边沿触发，带时钟使能 CE 与同步/异步复位。\n② 用来保存状态：寄存器、计数器、状态机。\n③ 输出只在时钟沿更新，建立/保持时间需满足。",
      "src": "AMD UG474"
    },
    {
      "id": "hw-c006",
      "sub": "arch",
      "title": "为何 LUT 多为 6 输入",
      "body": "① 4 输入表达能力不足，7 输入 SRAM 翻倍但收益递减。\n② 6 输入覆盖绝大多数组合函数，面积/性能最优。\n③ 更大函数靠多级 LUT + 进位/布线级联。",
      "src": "AMD UG474"
    },
    {
      "id": "hw-c007",
      "sub": "memdsp",
      "title": "BRAM 块存储器",
      "body": "① 7 系列块 RAM 基本为 36 Kb。\n② 真双口，两端口可独立读写、独立时钟。\n③ 适合片上较大缓冲：FIFO、帧缓存、查找表。",
      "src": "AMD UG473"
    },
    {
      "id": "hw-c008",
      "sub": "memdsp",
      "title": "BRAM 拆分为 18Kb",
      "body": "① 一个 36Kb BRAM 可当两个独立 18Kb 用。\n② 提高小容量应用的利用率。\n③ 带 ECC/校验/级联可选。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c009",
      "sub": "memdsp",
      "title": "分布式 RAM",
      "body": "① 用 SLICEM 的 LUT 构成小容量 RAM。\n② 容量小、散布在逻辑里，不用占 BRAM。\n③ 适合小 FIF O/寄存器堆。",
      "src": "AMD UG474"
    },
    {
      "id": "hw-c010",
      "sub": "memdsp",
      "title": "DSP48E1 切片",
      "body": "① 含预加器 + 25×18 乘法器 + 加法器/48bit 累加器。\n② 一个切片完成乘加 MAC。\n③ 做滤波、FFT、数字运算的硬单元。",
      "src": "AMD UG479"
    },
    {
      "id": "hw-c011",
      "sub": "memdsp",
      "title": "URAM",
      "body": "① UltraScale+ 引入，单块 288 Kb。\n② 比 BRAM 更大，适合超深缓存。\n③ 7 系列没有 URAM。",
      "src": "AMD UG573"
    },
    {
      "id": "hw-c012",
      "sub": "memdsp",
      "title": "SRL 移位寄存器",
      "body": "① 用 LUT 配置成 32 位移位寄存器。\n② 做小延时线/流水线抽头。\n③ 不占用 BRAM。",
      "src": "AMD UG474"
    },
    {
      "id": "hw-c013",
      "sub": "clockres",
      "title": "BUFG 全局时钟缓冲",
      "body": "① 把时钟低偏移分发到整个芯片。\n② 7 系列约 32 个 BUFG。\n③ 主时钟/高频全局逻辑时钟应走 BUFG。",
      "src": "AMD UG472"
    },
    {
      "id": "hw-c014",
      "sub": "clockres",
      "title": "MMCM 混合时钟管理器",
      "body": "① 7 系列 CMT 内为 MMCM（前代 PLL）。\n② 支持倍频、分频、相移、去偏斜。\n③ 一个晶振可出多路不同时钟。",
      "src": "AMD UG472"
    },
    {
      "id": "hw-c015",
      "sub": "clockres",
      "title": "BUFR 区域时钟缓冲",
      "body": "① 区域性时钟，驱动一个时钟区域。\n② 可做分频/对齐。\n③ 介于 BUFG 与普通布线之间。",
      "src": "AMD UG472"
    },
    {
      "id": "hw-c016",
      "sub": "clockres",
      "title": "时钟区域",
      "body": "① 芯片按时钟区域划分布局。\n② 同一区域内同步，降低偏斜。\n③ 多时钟域按区域规划布线。",
      "src": "AMD UG472"
    },
    {
      "id": "hw-c017",
      "sub": "clockres",
      "title": "IOB 输入输出块",
      "body": "① 引脚与内部逻辑之间的接口。\n② 可把触发器放入 IOB，减小引脚到 FF 延时。\n③ 带电平匹配/上下拉。",
      "src": "AMD UG471"
    },
    {
      "id": "hw-c018",
      "sub": "clockres",
      "title": "布线与互连矩阵",
      "body": "① LUT/FF 之间靠通用互连与开关矩阵连接。\n② 布局布线决定走线延迟。\n③ 关键路径资源占用影响时序收敛。",
      "src": "AMD UG474"
    },
    {
      "id": "hw-c019",
      "sub": "families",
      "title": "Artix-7",
      "body": "① 定位：低成本、高逻辑/引脚比。\n② 教学与消费类常用（如 XC7A100T）。\n③ 资源适中，性价比高。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c020",
      "sub": "families",
      "title": "Kintex-7",
      "body": "① 定位：性能与成本平衡。\n② 更多高速收发器/存储，适合中高端。\n③ 比 Artix 性能高、比 Virtex 便宜。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c021",
      "sub": "families",
      "title": "Zynq-7000",
      "body": "① PS（ARM Cortex-A9 双核）+ PL（FPGA）。\n② 软硬件协同：处理器跑软件，PL 加速。\n③ 单芯片 SoC。",
      "src": "AMD UG585"
    },
    {
      "id": "hw-c022",
      "sub": "families",
      "title": "Zynq UltraScale+",
      "body": "① PS 为 ARM 64 位多核（CA53 等）。\n② PL 为 UltraScale+ 结构，含 URAM/DSP48E2。\n③ 高端嵌入式/视觉。",
      "src": "AMD UG1085"
    },
    {
      "id": "hw-c023",
      "sub": "families",
      "title": "Spartan-7",
      "body": "① 最低成本、最低功耗入门系列。\n② 资源较少，简单逻辑/粘接逻辑。\n③ 教学与量产低成本选型。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c024",
      "sub": "families",
      "title": "速度等级",
      "body": "① 后缀 -1/-2/-3，-3 最快也最贵。\n② 决定器件能跑的最高频率。\n③ 工业级温度等级另标。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c025",
      "sub": "board",
      "title": "晶振时钟源",
      "body": "① 开发板用外部晶振提供主时钟，常见 50MHz。\n② FPGA 本身不产生时钟，靠外部输入。\n③ 经 MMCM 倍频/分频出内部时钟。",
      "src": "AMD UG472"
    },
    {
      "id": "hw-c026",
      "sub": "board",
      "title": "复位电路",
      "body": "① 常用 RC 上电复位 + 手动按键。\n② 按键外接上拉，按下为低。\n③ 复位信号需同步到时钟域。",
      "src": ""
    },
    {
      "id": "hw-c027",
      "sub": "board",
      "title": "按键/LED/拨码",
      "body": "① 按键：输入，需消抖。\n② LED：输出，串限流电阻。\n③ 拨码开关：配置电平输入。",
      "src": ""
    },
    {
      "id": "hw-c028",
      "sub": "board",
      "title": "Bank 与 Vcco",
      "body": "① I/O 按 Bank 分组，每个 Bank 一个 Vcco。\n② Vcco 决定该 Bank 的 I/O 电平标准。\n③ 常见 3.3V/2.5V/1.8V/1.5V/1.2V。",
      "src": "AMD UG471"
    },
    {
      "id": "hw-c029",
      "sub": "board",
      "title": "电源与稳压",
      "body": "① 板上多路 DC-DC/LDO 产生各电压。\n② 核电压大电流、低纹波。\n③ I/O 电压按 Bank 供电。",
      "src": ""
    },
    {
      "id": "hw-c030",
      "sub": "board",
      "title": "外设接插件",
      "body": "① 扩展口/排针把引脚引出。\n② VGA/UART/HDMI/LED 等接插件。\n③ 引脚分配见板卡原理图/XDC。",
      "src": ""
    },
    {
      "id": "hw-c031",
      "sub": "config",
      "title": "JTAG 配置模式",
      "body": "① 下载电缆直连，调试最方便。\n② 信号 TCK/TMS/TDI/TDO。\n③ 掉电丢失，适合开发阶段。",
      "src": "AMD UG470"
    },
    {
      "id": "hw-c032",
      "sub": "config",
      "title": "Master/Slave 配置",
      "body": "① Master 模式 FPGA 主动从配置 Flash 读比特流。\n② Slave 模式由外部主机提供时钟。\n③ 上电自动加载用 Master SPI。",
      "src": "AMD UG470"
    },
    {
      "id": "hw-c033",
      "sub": "config",
      "title": "配置 Flash",
      "body": "① 外置 SPI/BPI Flash 存比特流。\n② 掉电不丢，上电自动加载。\n③ 量产产品必备。",
      "src": "AMD UG470"
    },
    {
      "id": "hw-c034",
      "sub": "config",
      "title": "比特流文件",
      "body": "① .bit（含调试）/.bin（裸数据）。\n② 由 Vivado 实现后生成。\n③ 本质是配置 SRAM 的数据。",
      "src": "AMD UG835"
    },
    {
      "id": "hw-c035",
      "sub": "config",
      "title": "启动流程",
      "body": "① 清空配置 -> 加载比特流 -> 启动序列 -> 释放 I/O。\n② DONE 拉高表示配置完成。\n③ INIT_B 表示初始化。",
      "src": "AMD UG470"
    },
    {
      "id": "hw-c036",
      "sub": "config",
      "title": "下载电缆",
      "body": "① AMD Platform Cable USB（DLC）。\n② JTAG 链路连接 PC 与板子。\n③ 也可用兼容下载器。",
      "src": "AMD UG470"
    },
    {
      "id": "hw-c037",
      "sub": "power",
      "title": "核电压 Vccint",
      "body": "① 7 系列核电压约 1.0V。\n② 为内部逻辑供电，电流大。\n③ 纹波要求低。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c038",
      "sub": "power",
      "title": "辅助电压 Vccaux",
      "body": "① 7 系列典型 1.8V。\n② 辅助电路/配置等供电。\n③ 不等于核电压。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c039",
      "sub": "power",
      "title": "Bank 电压 Vcco",
      "body": "① 每个 Bank 独立。\n② 决定 I/O 电平。\n③ 按外设接口选择。",
      "src": "AMD UG471"
    },
    {
      "id": "hw-c040",
      "sub": "power",
      "title": "去耦电容",
      "body": "① 每个电源引脚就近放 0.1µF。\n② 抑制电源纹波/瞬态电流。\n③ 配合大容量电容。",
      "src": ""
    },
    {
      "id": "hw-c041",
      "sub": "power",
      "title": "上电时序",
      "body": "① 一般核电压先稳定，再上 I/O。\n② 避免锁死/浪涌。\n③ 按数据手册顺序。",
      "src": "AMD DS180"
    },
    {
      "id": "hw-c042",
      "sub": "power",
      "title": "复位设计",
      "body": "① 异步复位、同步释放。\n② 避免亚稳态。\n③ 复位信号同步到对应时钟域。",
      "src": "AMD UG949"
    }
