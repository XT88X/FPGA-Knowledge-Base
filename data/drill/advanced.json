{
  "cat": "advanced",
  "catName": "IP 核、RISC-V 软核与硬件加速进阶",
  "cards": [
    {
      "id": "adv-c01",
      "sub": "ip",
      "title": "什么是IP核",
      "body": "① 预先写好、验证过、可复用的功能模块；② 分软核(HDL综合)与硬核(版图固定)；③ 在Vivado IP Catalog里调用。",
      "src": "AMD UG896"
    },
    {
      "id": "adv-c02",
      "sub": "ip",
      "title": "软核vs硬核",
      "body": "① 软核=HDL网表/RTL，可综合到任意FPGA，可改；② 硬核=晶体管级固定版图，性能高不可改；③ Xilinx RAM/FIFO多为软核，PCIe Gen3 Integrated Block含硬核。",
      "src": ""
    },
    {
      "id": "adv-c03",
      "sub": "ip",
      "title": "IP Catalog",
      "body": "① Vivado里集中管理官方/第三方/自定义IP；② 图形化配置参数并生成输出产品；③ 生成后用例化模板或Block Design挂载。",
      "src": "AMD UG896"
    },
    {
      "id": "adv-c04",
      "sub": "ip",
      "title": "Clocking Wizard",
      "body": "① 例化MMCM/PLL；② 输入时钟分频/倍频出多路时钟；③ 输出去抖动、相位、动态重配置；④ 对应缓冲区BUFG。",
      "src": "AMD PG065 Clocking Wizard"
    },
    {
      "id": "adv-c05",
      "sub": "ip",
      "title": "Block Memory Generator",
      "body": "① 例化片上BRAM；② 配单口/简单双口/真双口、位宽、深度、输出寄存器；③ 可加初始化coe文件；④ 比分布式RAM省LUT、容量大。",
      "src": "AMD PG058"
    },
    {
      "id": "adv-c06",
      "sub": "ip",
      "title": "FIFO Generator",
      "body": "① 例化同步/异步FIFO；② 跨时钟域用异步FIFO；③ 带满空阈值、几乎满/几乎空；④ 内部用BRAM/分布式RAM实现。",
      "src": "AMD PG057"
    },
    {
      "id": "adv-c07",
      "sub": "ip",
      "title": "参数化与例化",
      "body": "① parameter/localparam定义位宽/深度；② 例化时#(.W(8))覆盖；③ 同一个IP换参数即新实例；④ 建议端口位宽用参数而非魔数。",
      "src": ""
    },
    {
      "id": "adv-c08",
      "sub": "ip",
      "title": "自定义IP封装流程",
      "body": "① 写好RTL并验证；② Package IP:打包成Vivado IP；③ 暴露参数/接口；④ 加GUI/文档即可在Catalog复用。",
      "src": "AMD UG1118"
    },
    {
      "id": "adv-c09",
      "sub": "riscv",
      "title": "开源ISA",
      "body": "① RISC-V是开放指令集规范，无授权费；② 基础整数RV32I；③ 可按需要加M/A/F/D/C等扩展；④ 规范在docs.riscv.org。",
      "src": "RISC-V Unpriv Spec"
    },
    {
      "id": "adv-c10",
      "sub": "riscv",
      "title": "寄存器x0~x31",
      "body": "① x0恒零不可写；② x1 ra返回地址,x2 sp栈；③ x5-x7/x28-31临时t0-t6；④ x10-x11参数a0-a1兼返回；⑤ x8/x9,x18-27保存s。",
      "src": "RISC-V Unpriv Spec"
    },
    {
      "id": "adv-c11",
      "sub": "riscv",
      "title": "六种指令格式",
      "body": "① R型寄存器运算；② I型立即数/load/jalr；③ S型store；④ B型分支；⑤ U型lui/auipc；⑥ J型jal。",
      "src": ""
    },
    {
      "id": "adv-c12",
      "sub": "riscv",
      "title": "opcode/funct3/funct7",
      "body": "① 低7位opcode决定大类；② funct3细分；③ funct7区分add/sub等同op；④ 定长32位(解压除外)。",
      "src": ""
    },
    {
      "id": "adv-c13",
      "sub": "riscv",
      "title": "lui/auipc",
      "body": "① lui把20位立即数放rd高位；② auipc=pc+立即数；③ 用于加载32位常数/取地址。",
      "src": ""
    },
    {
      "id": "adv-c14",
      "sub": "riscv",
      "title": "跳转分支",
      "body": "① jal=相对跳转写返回地址rd；② jalr=寄存器间接跳转；③ beq/bne按rs1,rs2比较；④ 分支目标按2字节对齐。",
      "src": ""
    },
    {
      "id": "adv-c15",
      "sub": "riscv",
      "title": "load/store与小端",
      "body": "① lw/sw按字load/store；② RISC-V默认小端；③ 未对齐访问在本教学核不支持；④ 地址字节单位。",
      "src": ""
    },
    {
      "id": "adv-c16",
      "sub": "riscv",
      "title": "扩展M/A/C/F",
      "body": "① M=乘除；② A=原子同步；③ C=16位压缩指令省代码；④ F/D=单/双浮点；⑤ E=嵌入式16寄存器。",
      "src": ""
    },
    {
      "id": "adv-c17",
      "sub": "soc",
      "title": "五级流水线",
      "body": "① IF取指->ID译码->EX执行->MEM访存->WB写回；② 单周期把五级压成一拍；③ 流水线提吞吐但有冒险。",
      "src": "RISC-V教材"
    },
    {
      "id": "adv-c18",
      "sub": "soc",
      "title": "x0恒零与寄存器堆",
      "body": "① 32个通用寄存器；② x0硬连线为0；③ 双口读单口写；④ 组合读同步写。",
      "src": ""
    },
    {
      "id": "adv-c19",
      "sub": "soc",
      "title": "哈佛vs冯诺依曼",
      "body": "① 哈佛：指令/数据分开存储器口；② 冯诺依曼：共用一块RAM；③ 教学核多用冯诺依曼省资源。",
      "src": ""
    },
    {
      "id": "adv-c20",
      "sub": "soc",
      "title": "总线与内存映射",
      "body": "① 外设寄存器占固定地址；② CPU用lw/sw访问外设；③ 地址译码片选；④ 如UART_DATA=0x20000000。",
      "src": ""
    },
    {
      "id": "adv-c21",
      "sub": "soc",
      "title": "外设地址映射",
      "body": "① UART数据/状态；② GPIO方向/输出/输入；③ Timer控制/比较/计数；④ 中断使能/标志。",
      "src": ""
    },
    {
      "id": "adv-c22",
      "sub": "soc",
      "title": "中断与异常向量",
      "body": "① 中断跳转到固定trap向量；② 硬件保存返回地址；③ ISR清标志后返回；④ 教学版无完整特权架构。",
      "src": ""
    },
    {
      "id": "adv-c23",
      "sub": "soc",
      "title": "PicoRV32",
      "body": "① ClaireWolf/Yosys出品；② 极小RV32I/E/M/C软核；③ 约数百到数千LUT；④ 适合资源受限。",
      "src": "github.com/YosysHQ/picorv32"
    },
    {
      "id": "adv-c24",
      "sub": "soc",
      "title": "NEORV32",
      "body": "① Stephan Nolting出品；② 类单片机SoC自带UART/GPIO/Timer/中断；③ 开源、文档齐全；④ 适合直接做软MCU。",
      "src": "github.com/stnolting/neorv32"
    },
    {
      "id": "adv-c25",
      "sub": "accel",
      "title": "CPU串行vs并行",
      "body": "① CPU每周期一条指令；② FPGA多块电路同时工作；③ 加速来自同拍做更多而非提频。",
      "src": ""
    },
    {
      "id": "adv-c26",
      "sub": "accel",
      "title": "流水线与展开",
      "body": "① 流水线分级插寄存提频；② 展开(unroll)复制功能单元并行；③ 用面积换时间。",
      "src": ""
    },
    {
      "id": "adv-c27",
      "sub": "accel",
      "title": "吞吐与延迟",
      "body": "① 延迟=一条数据从进来到出去的周期；② 吞吐=每拍出几个结果；③ 流水线填满后吞吐高、延迟固定。",
      "src": ""
    },
    {
      "id": "adv-c28",
      "sub": "accel",
      "title": "valid/ready背压",
      "body": "① valid数据有效,ready下游可收；② 两高同拍才成交；③ ready拉低即背压,上游保持数据。",
