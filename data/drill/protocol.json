    {"id":"proto-006","cat":"protocol","sub":"uart","type":"single","q":"下列哪个是常见 UART 波特率？","options":["115200","25MHz","50MHz","1MHz"],"answer":0,"explain":"115200 最常用。","src":""},
    {"id":"proto-007","cat":"protocol","sub":"uart","type":"single","q":"UART 是哪种通信？","options":["同步串行","异步串行","并行","差分"],"answer":1,"explain":"无时钟线，异步。","src":""},
    {"id":"proto-008","cat":"protocol","sub":"uart","type":"single","q":"uart_echo_top 的功能是？","options":["收到即回发","循环发固定字","只收不发","产生波特率"],"answer":0,"explain":"RX 收到直接喂 TX 发回。","src":""},
    {"id":"proto-009","cat":"protocol","sub":"uart","type":"single","q":"停止位的电平是？","options":["低","高","高阻","由从机决定"],"answer":1,"explain":"停止位高电平，标志帧结束。","src":""},
    {"id":"proto-010","cat":"protocol","sub":"uart","type":"multi","q":"下列关于 UART 说法正确的有？","options":["UART 异步通信","UART 无时钟线","UART 是全双工","UART 需要片选线"],"answer":[0,1,2],"explain":"UART 无片选线。","src":""},
    {"id":"proto-011","cat":"protocol","sub":"uart","type":"judge","q":"UART 是全双工通信。","answer":true,"explain":"对。TX/RX 独立可同时收发。","src":""},
    {"id":"proto-012","cat":"protocol","sub":"uart","type":"judge","q":"接收端波特率与发送端不一致会导致采样错位。","answer":true,"explain":"对。波特率须双方一致。","src":""},
    {"id":"proto-013","cat":"protocol","sub":"uart","type":"judge","q":"frame_err 在停止位不是高电平时置位。","answer":true,"explain":"对。帧错误标志。","src":""},
    {"id":"proto-014","cat":"protocol","sub":"uart","type":"fill","q":"50MHz 下 115200 波特率的 BIT_DIV ≈ ____。","answer":["434","434.0"],"explain":"50M/115200≈434。","src":""},
    {"id":"proto-015","cat":"protocol","sub":"uart","type":"fill","q":"16 倍过采样下 OV_DIV ≈ ____。","answer":["27","27.0"],"explain":"50M/(115200×16)≈27。","src":""},
    {"id":"proto-016","cat":"protocol","sub":"uart","type":"single","q":"UART 8N1 中 N 代表什么？","options":["有校验","无校验","1 个停止位","1 个起始位"],"answer":1,"explain":"N=no parity 无校验。","src":""},
    {"id":"proto-017","cat":"protocol","sub":"uart","type":"multi","q":"下列哪些是 UART 帧的组成？","options":["起始位","8 数据位","停止位","时钟线"],"answer":[0,1,2],"explain":"UART 无时钟线。","src":""},
    {"id":"proto-018","cat":"protocol","sub":"uart","type":"multi","q":"下列关于 UART 说法正确的有？","options":["异步","点对点","全双工","有片选线"],"answer":[0,1,2],"explain":"UART 无片选。","src":""},
    {"id":"proto-019","cat":"protocol","sub":"uart","type":"multi","q":"UART 常用于下列哪些场景？","options":["FPGA 串口调试","GPS 模块","蓝牙串口","驱动 OLED"],"answer":[0,1,2],"explain":"OLED 用 SPI/I2C。","src":""},
    {"id":"proto-020","cat":"protocol","sub":"uart","type":"single","q":"RS-232 电平与 TTL 之间需要什么芯片？","options":["MAX232","PLL","DDR","FPGA"],"answer":0,"explain":"MAX232 做电平转换。","src":""},
