    {"id":"proto-022","cat":"protocol","sub":"uart","type":"fill","q":"UART 起始位是 ___ 电平。","answer":["低","low","0"],"explain":"从空闲高拉低。","src":""},

    {"id":"proto-023","cat":"protocol","sub":"spi","type":"single","q":"SPI 四根线不包括下列哪根？","options":["SCLK","MOSI","MISO","SDA"],"answer":3,"explain":"SDA 是 I2C。","src":""},
    {"id":"proto-024","cat":"protocol","sub":"spi","type":"single","q":"CPOL=0/CPHA=0 时 SCLK 空闲电平是？","options":["低","高","高阻","随机"],"answer":0,"explain":"CPOL=0 空闲低。","src":""},
    {"id":"proto-025","cat":"protocol","sub":"spi","type":"single","q":"SPI 片选 CS_N 有效电平是？","options":["高","低","高阻","由从机决定"],"answer":1,"explain":"CS_N 低有效。","src":""},
    {"id":"proto-026","cat":"protocol","sub":"spi","type":"single","q":"50MHz 下 HALF=25，SCLK 频率为？","options":["1MHz","2MHz","25MHz","500kHz"],"answer":0,"explain":"50M/(2×25)=1MHz。","src":""},
    {"id":"proto-027","cat":"protocol","sub":"spi","type":"single","q":"SPI 数据位通常先发？","options":["MSB","LSB","中间","并行"],"answer":0,"explain":"SPI 默认 MSB 先出。","src":""},
    {"id":"proto-028","cat":"protocol","sub":"spi","type":"single","q":"SPI 是哪种通信？","options":["同步全双工","异步半双工","并行","差分"],"answer":0,"explain":"同步、全双工。","src":""},
    {"id":"proto-029","cat":"protocol","sub":"spi","type":"single","q":"SPI 一主多从时如何选从机？","options":["发地址","拉低对应 CS","广播","随机"],"answer":1,"explain":"每从机独立 CS。","src":""},
    {"id":"proto-030","cat":"protocol","sub":"spi","type":"single","q":"SSD1306 OLED 的 DC 引脚作用是？","options":["选从机","区分命令与数据","复位","时钟"],"answer":1,"explain":"DC=0 命令，DC=1 数据。","src":"Solomon Systech SSD1306"},
    {"id":"proto-031","cat":"protocol","sub":"spi","type":"multi","q":"下列关于 SPI 说法正确的有？","options":["SPI 是全双工","SPI 有 SCLK 时钟线","SPI 用 CS 选从机","SPI 是半双工"],"answer":[0,1,2],"explain":"SPI 全双工。","src":""},
    {"id":"proto-032","cat":"protocol","sub":"spi","type":"judge","q":"SPI 主机产生 SCLK，从机不能产生时钟。","answer":true,"explain":"对。同步由主机提供。","src":""},
    {"id":"proto-033","cat":"protocol","sub":"spi","type":"judge","q":"CPOL/CPHA 四种模式下从机必须与主机设置一致。","answer":true,"explain":"对。否则采样沿不对。","src":""},
    {"id":"proto-034","cat":"protocol","sub":"spi","type":"judge","q":"SPI 通信期间 CS_N 应保持高电平。","answer":false,"explain":"错。通信期间拉低选中从机。","src":""},
    {"id":"proto-035","cat":"protocol","sub":"spi","type":"fill","q":"SPI 四根线是 SCLK、MOSI、MISO 和 ____。","answer":["CS","CS_N","片选","ss"],"explain":"Chip Select。","src":""},
    {"id":"proto-036","cat":"protocol","sub":"spi","type":"fill","q":"50MHz 下 HALF=25，SCLK=____ MHz。","answer":["1","1.0","1mhz"],"explain":"50M/50=1MHz。","src":""},
    {"id":"proto-037","cat":"protocol","sub":"spi","type":"fill","q":"SPI 通信中主机产生的时钟线叫 ____。","answer":["SCLK","sclk","SCK"],"explain":"Serial Clock。","src":""},
    {"id":"proto-038","cat":"protocol","sub":"spi","type":"multi","q":"SPI 的四种 CPOL/CPHA 组合包括？","options":["CPOL=0/CPHA=0","CPOL=0/CPHA=1","CPOL=1/CPHA=0","CPOL=1/CPHA=1"],"answer":[0,1,2,3],"explain":"4 种全列。","src":""},
    {"id":"proto-039","cat":"protocol","sub":"spi","type":"multi","q":"下列哪些是 SPI 的特点？","options":["全双工","同步","MSB 先出","需地址选从机"],"answer":[0,1,2],"explain":"SPI 用 CS 不用地址。","src":""},
    {"id":"proto-040","cat":"protocol","sub":"spi","type":"multi","q":"SSD1306 OLED 的关键参数有？","options":["128×64 分辨率","8 页显存","DC 区分命令数据","I2C 地址"],"answer":[0,1,2],"explain":"SSD1306 4 线 SPI 无地址。","src":"Solomon Systech SSD1306"},
    {"id":"proto-041","cat":"protocol","sub":"spi","type":"single","q":"SSD1306 显存分为多少页？","options":["4","8","16","32"],"answer":1,"explain":"64 行/8=8 页。","src":"Solomon Systech SSD1306"},
    {"id":"proto-042","cat":"protocol","sub":"spi","type":"judge","q":"SPI 比 I2C 速度快。","answer":true,"explain":"对。SPI MHz 级，I2C 一般 400k 以下。","src":""},
    {"id":"proto-043","cat":"protocol","sub":"spi","type":"fill","q":"SSD1306 OLED 分辨率是 128×____。","answer":["64","64像素"],"explain":"128×64。","src":"Solomon Systech SSD1306"},
    {"id":"proto-044","cat":"protocol","sub":"spi","type":"single","q":"SPI 通信中 MISO 的方向是？","options":["主出从入","主入从出","双向","输出使能"],"answer":1,"explain":"Master In Slave Out。","src":""},

    {"id":"proto-045","cat":"protocol","sub":"i2c","type":"single","q":"I2C 总线使用几根线？","options":["1","2","3","4"],"answer":1,"explain":"SDA+SCL。","src":"NXP UM10204"},
