{
  "cat": "protocol",
  "catName": "常用通信协议与显示接口（UART/SPI/I2C/VGA/AXI）",
  "cards": [
    {"id":"proto-c01","sub":"uart","title":"UART 帧格式 8N1","body":"① 异步串行，无时钟线。\n② 1 起始位(低)+8 数据位(LSB先)+无校验+1 停止位(高)。\n③ 双方须约定相同波特率。","src":""},
    {"id":"proto-c02","sub":"uart","title":"波特率分频","body":"① BIT_DIV = CLK / 波特率。\n② 50MHz/115200 ≈ 434。\n③ 常用波特率 9600/115200。","src":""},
    {"id":"proto-c03","sub":"uart","title":"16 倍过采样","body":"① 接收端对每位采样 16 次。\n② 在第 8 个采样点(中点)判决，避开沿抖动。\n③ OV_DIV = CLK/(波特率×16) ≈ 27。","src":""},
    {"id":"proto-c04","sub":"uart","title":"UART 全双工","body":"① TX/RX 两根独立线，可同时收发。\n② 点对点通信，无片选。\n③ 流控(RTS/CTS)为可选硬件握手。","src":""},
    {"id":"proto-c05","sub":"uart","title":"UART 帧错误","body":"① 停止位不是高电平→frame_err。\n② 波特率不匹配会导致采样错位。\n③ 起始位下降沿检测唤醒接收。","src":""},
    {"id":"proto-c06","sub":"uart","title":"UART 典型用途","body":"① FPGA 与 PC 串口调试。\n② 蓝牙/GPS 模块。\n③ 低速率板间通信。","src":""},
    {"id":"proto-c07","sub":"uart","title":"UART 电平","body":"① TTL 串口 3.3V/5V 电平。\n② RS-232 用 ±12V，需 MAX232 转换。\n③ USB 转串口桥接芯片常用。","src":""},

    {"id":"proto-c08","sub":"spi","title":"SPI 四线","body":"① SCLK 时钟、MOSI 主出从入、MISO 主入从出、CS 片选。\n② 同步、全双工。\n③ 一主多从，每个从机一根 CS。","src":""},
    {"id":"proto-c09","sub":"spi","title":"CPOL/CPHA 四模式","body":"① CPOL=空闲电平，CPHA=采样沿。\n② Mode0: CPOL=0/CPHA=0，空闲低，上升沿采样。\n③ 共 4 种模式，从机须与主机一致。","src":""},
    {"id":"proto-c10","sub":"spi","title":"SPI 分频","body":"① SCLK = CLK/(2×HALF)。\n② 50MHz 下 HALF=25 → SCLK=1MHz。\n③ MSB 先出。","src":""},
    {"id":"proto-c11","sub":"spi","title":"SPI 片选","body":"① CS_N 低有效。\n② 通信前拉低选中从机。\n③ 通信结束拉高释放总线。","src":""},
    {"id":"proto-c12","sub":"spi","title":"SPI vs I2C","body":"① SPI 快、线多、全双工。\n② I2C 线少、半双工、带地址。\n③ SPI 无地址，靠 CS 选从机。","src":""},
    {"id":"proto-c13","sub":"spi","title":"SSD1306 OLED","body":"① 128×64 分辨率，8 页×128 列。\n② DC 引脚区分命令(0)与数据(1)。\n③ 初始化序列：0xAE/0x8D/0xAF 等。","src":"Solomon Systech SSD1306"},
    {"id":"proto-c14","sub":"spi","title":"SPI 典型速率","body":"① 常用 1~50MHz。\n② 比 I2C/UART 快很多。\n③ 受走线长度限制。","src":""},

    {"id":"proto-c15","sub":"i2c","title":"I2C 两线","body":"① SDA 数据、SCL 时钟。\n② 所有器件共线，靠地址区分。\n③ 半双工。","src":"NXP UM10204"},
    {"id":"proto-c16","sub":"i2c","title":"开漏+上拉","body":"① SDA/SCL 均为开漏输出。\n② 必须外接上拉电阻(典型 4.7k)。\n③ 实现线与：任一器件拉低即低。","src":"NXP UM10204"},
    {"id":"proto-c17","sub":"i2c","title":"起始/停止条件","body":"① START: SCL 高时 SDA 下降。\n② STOP: SCL 高时 SDA 上升。\n③ 数据传输期间 SDA 只能在 SCL 低时变。","src":"NXP UM10204"},
    {"id":"proto-c18","sub":"i2c","title":"7 位地址+R/W","body":"① 起始后发 7 位地址。\n② 第 8 位是 R/W(1=读,0=写)。\n③ 被寻址从机在第 9 拍回 ACK。","src":"NXP UM10204"},
    {"id":"proto-c19","sub":"i2c","title":"ACK/NACK","body":"① ACK: 接收方在第 9 拍拉低 SDA。\n② NACK: SDA 保持高。\n③ 每 8 位数据后都有 ACK/NACK。","src":"NXP UM10204"},
    {"id":"proto-c20","sub":"i2c","title":"I2C 速率模式","body":"① 标准 100 kbit/s。\n② 快速 400 kbit/s。\n③ 高速 3.4 Mbit/s。","src":"NXP UM10204"},
    {"id":"proto-c21","sub":"i2c","title":"多主与仲裁","body":"① 支持多主机。\n② 总线空闲时多主可同时发起。\n③ SDA 线与仲裁：输 1 读到 0 则失仲裁。","src":"NXP UM10204"},
    {"id":"proto-c22","sub":"i2c","title":"时钟拉伸","body":"① 从机来不及处理时拉低 SCL。\n② 主机等待 SCL 释放再继续。\n③ 是一种流控机制。","src":"NXP UM10204"},

    {"id":"proto-c23","sub":"vga","title":"VGA 行场同步","body":"① HSYNC 行同步、VSYNC 场同步。\n② 低有效脉冲。\n③ 消隐期间 RGB 输出黑色。","src":""},
    {"id":"proto-c24","sub":"vga","title":"640×480@60 时序","body":"① 行总 800=640可见+16前肩+96同步+48后肩。\n② 场总 525=480可见+10前肩+2同步+33后肩。\n③ 像素时钟 25.175MHz。","src":"VESA"},
    {"id":"proto-c25","sub":"vga","title":"像素坐标","body":"① pixel_x 0~639, pixel_y 0~479。\n② video_on=1 在可见区。\n③ 坐标决定该像素颜色。","src":""},
    {"id":"proto-c26","sub":"vga","title":"消隐区","body":"① 前肩/同步/后肩期间不显示。\n② RGB 输出 000。\n③ 显示器在此期间准备下一行/帧。","src":""},
    {"id":"proto-c27","sub":"vga","title":"并行 RGB","body":"① R/G/B 各一路模拟电压。\n② 需电阻网络 DAC 从数字转模拟。\n③ VGA 是并行显示接口。","src":""},
    {"id":"proto-c28","sub":"vga","title":"像素时钟使能","body":"① 50MHz 系统时钟。\n② 每 2 个时钟推进 1 像素≈25MHz。\n③ 不依赖 MMCM/PLL。","src":""},

    {"id":"proto-c29","sub":"axi","title":"AXI4 三种变体","body":"① AXI4(Full): 高性能内存映射，支持突发。\n② AXI4-Lite: 简单寄存器映射，单次传输。\n③ AXI4-Stream: 无地址流式数据。","src":"AMD UG1037"},
    {"id":"proto-c30","sub":"axi","title":"五通道","body":"① AW 写地址、W 写数据、B 写响应。\n② AR 读地址、R 读数据。\n③ 各通道独立 VALID/READY 握手。","src":"AMD UG1037"},
    {"id":"proto-c31","sub":"axi","title":"VALID/READY 握手","body":"① 主设备拉 VALID 表示数据有效。\n② 从设备拉 READY 表示可接收。\n③ 两者同时为高时完成一拍传输。","src":"AMD UG1037"},
    {"id":"proto-c32","sub":"axi","title":"AXI4-Lite","body":"① 每次只传一个数据(无突发)。\n② 用于配置寄存器。\n③ 资源占用少。","src":"AMD UG1037"},
    {"id":"proto-c33","sub":"axi","title":"AXI4-Stream","body":"① 无地址、无读写通道。\n② 单向数据流。\n③ 用于视频流、DMA 数据搬运。","src":"AMD UG1037"},
    {"id":"proto-c34","sub":"axi","title":"突发 Burst","body":"① AXI4 支持一次地址传多个数据。\n② 提高带宽。\n③ AXI4-Lite 不支持突发。","src":"AMD UG1037"},
    {"id":"proto-c35","sub":"axi","title":"AXI 互连","body":"① 多主多从通过 Interconnect 交叉矩阵连接。\n② ID 信号标识事务来源。\n③ Zynq PS 与 PL 之间常用 AXI。","src":"AMD UG1037"},

    {"id":"proto-c36","sub":"compare","title":"同步 vs 异步","body":"① SPI/VGA/AXI 同步(有时钟)。\n② UART 异步(无时钟，约定波特率)。\n③ I2C 有 SCL 但多主时可异步。","src":""},
    {"id":"proto-c37","sub":"compare","title":"管脚数对比","body":"① UART: 2(TX/RX)。\n② SPI: 4(SCLK/MOSI/MISO/CS)。\n③ I2C: 2(SDA/SCL)。\n④ VGA: 5+(HSYNC/VSYNC/RGB)。","src":""},
    {"id":"proto-c38","sub":"compare","title":"双工对比","body":"① UART/SPI 全双工。\n② I2C 半双工。\n③ AXI 读写通道独立但地址数据分离。","src":""},
    {"id":"proto-c39","sub":"compare","title":"速率对比","body":"① I2C 最慢(100k~400k)。\n② UART 次之(115200~1M)。\n③ SPI/VGA/AXI 最快(MHz 级)。","src":""},
    {"id":"proto-c40","sub":"compare","title":"选型建议","body":"① 引脚少/低速: I2C。\n② 高速全双工: SPI。\n③ 点对点调试: UART。\n④ 显示输出: VGA。\n⑤ 片内高带宽: AXI。","src":""},
    {"id":"proto-c41","sub":"compare","title":"上拉需求","body":"① I2C 必须上拉(开漏)。\n② UART TX 默认高。\n③ SPI CS 常带上拉默认高。","src":""},
    {"id":"proto-c42","sub":"compare","title":"典型用途对照","body":"① UART: 调试串口、GPS。\n② SPI: OLED/Flash/ADC。\n③ I2C: 传感器/RTC/EEPROM。\n④ VGA: 显示器输出。\n⑤ AXI: Zynq PS-PL 互连。","src":""}
  ],
